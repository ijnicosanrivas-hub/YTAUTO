# Copia este archivo a .env y ajusta los valores. NUNCA subas .env al repositorio.

# Clave maestra para cifrar credenciales de proveedores (Fernet, 32 bytes base64).
# Genera una con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
YTAUTO_MASTER_KEY=

# Directorio de datos (base de datos, proyectos, biblioteca)
YTAUTO_DATA_DIR=./data
YTAUTO_PROJECTS_DIR=./projects
YTAUTO_LIBRARY_DIR=./library

# Motor de Claude: "claude_cli" (usa tu sesión de Claude Code, `claude /login`) o "mock" (pruebas)
YTAUTO_LLM_PROVIDER=claude_cli
# Ruta al binario de Claude Code (por defecto se busca en PATH)
YTAUTO_CLAUDE_BIN=claude
# Concurrencia de tareas Claude (1 recomendado con Claude Pro)
YTAUTO_CLAUDE_CONCURRENCY=1
# Tiempo máximo por llamada a Claude (segundos)
YTAUTO_CLAUDE_TIMEOUT=600

# Las API keys de proveedores externos (ElevenLabs, Runway, etc.) NO van aquí:
# se introducen desde el panel "Proveedores" y se guardan cifradas.
