# Copia este archivo a .env y ajusta los valores. NUNCA subas .env al repositorio.

# --- Cifrado de credenciales de proveedores -------------------------------------------------------------
# Clave maestra Fernet. Si la dejas vacía se crea data/secrets/master.key (permisos 600, fuera de git).
# Genera una con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ¡Si la pierdes, las credenciales guardadas dejan de poder descifrarse!
YTAUTO_MASTER_KEY=

# --- Rutas (relativas a la raíz del repositorio o absolutas) ---------------------------------------------
YTAUTO_DATA_DIR=./data
YTAUTO_PROJECTS_DIR=./projects
YTAUTO_LIBRARY_DIR=./library
# YTAUTO_DB_PATH=./data/ytauto.db
# YTAUTO_BACKUPS_DIR=./backups
# YTAUTO_LOGS_DIR=./data/logs

# --- Claude (una única licencia Claude Pro vía Claude Code, sin API) -------------------------------------
# claude_cli = usa tu sesión de Claude Code (`claude /login`) · local_draft = borradores locales sin Claude (pruebas)
YTAUTO_LLM_PROVIDER=claude_cli
YTAUTO_CLAUDE_BIN=claude
# Tareas de Claude simultáneas: 1 recomendado (más no aumenta tu cuota, solo la agota antes). Máximo 2.
YTAUTO_CLAUDE_CONCURRENCY=1
# Tiempo máximo por llamada a Claude (segundos)
YTAUTO_CLAUDE_TIMEOUT=600

# Si la nota del revisor es apta pero marca incidencias GRAVES de guion o recursos, aplica una ronda de mejora
# (consume algunas llamadas más de Claude). 0 = desactivado. Un guion que aprobaste tú nunca se reescribe solo.
YTAUTO_FIX_MAJOR_ISSUES=1

# --- Servidor --------------------------------------------------------------------------------------------
# Obligatorio si escuchas fuera de 127.0.0.1: todas las rutas exigen `Authorization: Bearer <token>`.
# YTAUTO_API_TOKEN=
# Segundos que el servidor espera a la tarea en curso al apagarse
# YTAUTO_SHUTDOWN_GRACE_S=20

# Las API keys de proveedores externos (ElevenLabs, OpenAI, YouTube, Instagram, TikTok…) NO van aquí:
# se introducen en el panel «Proveedores» y se guardan cifradas.
