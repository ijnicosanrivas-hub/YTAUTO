{
  "name": "YTAUTO",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "20" }
  },
  "hostRequirements": { "cpus": 4 },
  "postCreateCommand": "bash scripts/codespace_setup.sh",
  "postStartCommand": "bash scripts/codespace_start.sh",
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": { "label": "YTAUTO", "onAutoForward": "openBrowser", "visibility": "private" }
  }
}
